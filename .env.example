# BenefitRadar environment variable names.
# Copy to .env and fill values locally. Do not commit values.
# cp .env.example .env

# 복지로 Open API / 공공데이터포털 지자체복지서비스 (보조금24)
# 발급: https://www.bokjiro.go.kr/ssis-tbu/openapi/openapiAgreementView.do
# 발급: https://www.data.go.kr
BOKJIRO_API_KEY=

# 실패 알림 웹훅. 값이 없으면 워크플로가 이름만 skip.json에 남긴다.
NOTIFICATION_WEBHOOK_URL=

# 선택 알림. 값은 커밋하지 않는다.
# SLACK_WEBHOOK_URL=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVER=

# DuckDB 압축. radar-core가 읽는다. 기본 예산은 90MiB.
# RADAR_DUCKDB_MAX_BYTES=
# RADAR_DUCKDB_COMPACT=
